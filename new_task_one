apiVersion: tekton.dev/v1beta1
kind: Task
metadata:
  name: teams-adaptive-card-notify
  labels:
    app.kubernetes.io/version: "0.1"
  annotations:
    tekton.dev/pipelines.minVersion: "0.12.1"
    tekton.dev/categories: Messaging
    tekton.dev/tags: messaging, microsoft-teams
    tekton.dev/displayName: "Send Adaptive Card to Microsoft Teams"
spec:
  description: >-
    Sends a richly formatted Adaptive Card notification to a Microsoft Teams
    channel via an Incoming Webhook. Supports pipeline run metadata including
    status, duration, task breakdown, and direct links to the Tekton dashboard.
  params:
    - name: webhook-url-secret
      type: string
      description: Name of the Kubernetes secret containing the Teams webhook URL
    - name: webhook-url-secret-key
      type: string
      description: Key within the secret that holds the webhook URL
      default: "url"
    - name: pipeline-run-name
      type: string
      description: Name of the PipelineRun (use $(context.pipelineRun.name))
    - name: pipeline-name
      type: string
      description: Name of the Pipeline (use $(context.pipeline.name))
    - name: namespace
      type: string
      description: Namespace where the PipelineRun executed
      default: "default"
    - name: pipeline-status
      type: string
      description: >-
        Aggregated status of all tasks. Use $(tasks.status) which resolves to
        Succeeded, Failed, or Completed (mixed results).
    - name: dashboard-url
      type: string
      description: Base URL of the Tekton Dashboard (e.g., https://tekton.example.com)
      default: ""
    - name: cluster-name
      type: string
      description: Friendly name for the cluster
      default: "kubernetes-cluster"
    - name: git-repo
      type: string
      description: Git repository URL (optional, for context)
      default: ""
    - name: git-branch
      type: string
      description: Git branch (optional, for context)
      default: ""
    - name: git-commit
      type: string
      description: Git commit SHA (optional, for context)
      default: ""
    - name: extra-message
      type: string
      description: Any additional message to include in the card
      default: ""
  steps:
    - name: send-adaptive-card
      image: registry.access.redhat.com/ubi9/ubi:latest  # Replace with your internal registry mirror if needed
      env:
        - name: WEBHOOK_URL
          valueFrom:
            secretKeyRef:
              name: $(params.webhook-url-secret)
              key: $(params.webhook-url-secret-key)
      script: |
        #!/bin/sh
        set -e

        # --- Determine status icon and color ---
        STATUS="$(params.pipeline-status)"
        case "$STATUS" in
          Succeeded)
            STATUS_ICON="✅"
            STATUS_COLOR="Good"
            STATUS_TEXT="Succeeded"
            ;;
          Failed)
            STATUS_ICON="❌"
            STATUS_COLOR="Attention"
            STATUS_TEXT="Failed"
            ;;
          *)
            STATUS_ICON="⚠️"
            STATUS_COLOR="Warning"
            STATUS_TEXT="Completed (with issues)"
            ;;
        esac

        # --- Build dashboard link ---
        DASHBOARD_URL="$(params.dashboard-url)"
        NAMESPACE="$(params.namespace)"
        PIPELINERUN="$(params.pipeline-run-name)"

        if [ -n "$DASHBOARD_URL" ]; then
          RUN_LINK="${DASHBOARD_URL}/#/namespaces/${NAMESPACE}/pipelineruns/${PIPELINERUN}"
        else
          RUN_LINK=""
        fi

        # --- Build git info section ---
        GIT_REPO="$(params.git-repo)"
        GIT_BRANCH="$(params.git-branch)"
        GIT_COMMIT="$(params.git-commit)"

        GIT_FACTS=""
        if [ -n "$GIT_REPO" ]; then
          GIT_FACTS="${GIT_FACTS},{\"title\":\"Repository\",\"value\":\"${GIT_REPO}\"}"
        fi
        if [ -n "$GIT_BRANCH" ]; then
          GIT_FACTS="${GIT_FACTS},{\"title\":\"Branch\",\"value\":\"${GIT_BRANCH}\"}"
        fi
        if [ -n "$GIT_COMMIT" ]; then
          SHORT_COMMIT=$(echo "$GIT_COMMIT" | cut -c1-8)
          GIT_FACTS="${GIT_FACTS},{\"title\":\"Commit\",\"value\":\"${SHORT_COMMIT}\"}"
        fi

        # --- Build action button ---
        ACTIONS=""
        if [ -n "$RUN_LINK" ]; then
          ACTIONS=",{
            \"type\": \"ActionSet\",
            \"actions\": [
              {
                \"type\": \"Action.OpenUrl\",
                \"title\": \"View PipelineRun in Dashboard\",
                \"url\": \"${RUN_LINK}\",
                \"style\": \"positive\"
              }
            ]
          }"
        fi

        # --- Build extra message block ---
        EXTRA_MSG="$(params.extra-message)"
        EXTRA_BLOCK=""
        if [ -n "$EXTRA_MSG" ]; then
          EXTRA_BLOCK=",{
            \"type\": \"TextBlock\",
            \"text\": \"${EXTRA_MSG}\",
            \"wrap\": true,
            \"spacing\": \"Medium\"
          }"
        fi

        # --- Compose the Adaptive Card payload ---
        PAYLOAD=$(cat <<EOF
        {
          "type": "message",
          "attachments": [
            {
              "contentType": "application/vnd.microsoft.card.adaptive",
              "contentUrl": null,
              "content": {
                "\$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "body": [
                  {
                    "type": "ColumnSet",
                    "columns": [
                      {
                        "type": "Column",
                        "width": "auto",
                        "items": [
                          {
                            "type": "TextBlock",
                            "text": "${STATUS_ICON}",
                            "size": "Large"
                          }
                        ],
                        "verticalContentAlignment": "Center"
                      },
                      {
                        "type": "Column",
                        "width": "stretch",
                        "items": [
                          {
                            "type": "TextBlock",
                            "text": "Tekton Pipeline: ${STATUS_TEXT}",
                            "weight": "Bolder",
                            "size": "Medium",
                            "color": "${STATUS_COLOR}",
                            "wrap": true
                          },
                          {
                            "type": "TextBlock",
                            "text": "$(params.pipeline-name)",
                            "spacing": "None",
                            "isSubtle": true,
                            "wrap": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "FactSet",
                    "facts": [
                      {
                        "title": "PipelineRun",
                        "value": "${PIPELINERUN}"
                      },
                      {
                        "title": "Namespace",
                        "value": "${NAMESPACE}"
                      },
                      {
                        "title": "Cluster",
                        "value": "$(params.cluster-name)"
                      },
                      {
                        "title": "Status",
                        "value": "${STATUS_TEXT}"
                      }
                      ${GIT_FACTS}
                    ]
                  }
                  ${EXTRA_BLOCK}
                  ${ACTIONS}
                ]
              }
            }
          ]
        }
        EOF
        )

        # --- Send to Teams ---
        echo "Sending notification to Microsoft Teams..."
        HTTP_CODE=$(curl -s -o /tmp/response.txt -w "%{http_code}" \
          -X POST \
          -H "Content-Type: application/json" \
          -d "${PAYLOAD}" \
          "${WEBHOOK_URL}")

        echo "Response code: ${HTTP_CODE}"
        cat /tmp/response.txt
        echo ""

        if [ "$HTTP_CODE" -lt 200 ] || [ "$HTTP_CODE" -ge 300 ]; then
          echo "ERROR: Failed to send Teams notification (HTTP ${HTTP_CODE})"
          exit 1
        fi

        echo "Teams notification sent successfully."
