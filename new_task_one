# task-extract-payload.yaml
apiVersion: tekton.dev/v1beta1
kind: Task
metadata:
  name: extract-pipelinerun-payload
  namespace: tekton-pipelines
spec:
  description: >
    Extracts PipelineRun event data and builds a structured JSON
    payload for downstream notification tasks.
  params:
    - name: pipeline-name
      type: string
      description: Name of the pipeline that triggered the event
    - name: pipelinerun-name
      type: string
      description: Name of the PipelineRun
    - name: status
      type: string
      description: Current status (Started, Succeeded, Failed, etc.)
    - name: namespace
      type: string
      default: "default"
  results:
    - name: notification-payload
      description: JSON payload ready to send to Power Automate
    - name: status-emoji
      description: Emoji indicator for the status (for message formatting)
  steps:
    - name: build-payload
      image: mcr.microsoft.com/powershell:7.4-alpine-3.17
      script: |
        #!/usr/bin/env pwsh
        Set-StrictMode -Version Latest
        $ErrorActionPreference = 'Stop'

        $pipelineName    = "$(params.pipeline-name)"
        $pipelineRunName = "$(params.pipelinerun-name)"
        $status          = "$(params.status)"
        $namespace       = "$(params.namespace)"

        # Map status to emoji and human-readable label.
        # Why here and not in the sender? Because formatting decisions
        # are part of payload shaping — the sender should just deliver.
        $statusMap = @{
            'Started'   = @{ emoji = '🚀'; label = 'Started' }
            'Running'   = @{ emoji = '⏳'; label = 'Running' }
            'Succeeded' = @{ emoji = '✅'; label = 'Succeeded' }
            'Completed' = @{ emoji = '✅'; label = 'Completed' }
            'Failed'    = @{ emoji = '❌'; label = 'Failed' }
        }

        $mapped = $statusMap[$status]
        if (-not $mapped) {
            # Fallback for unexpected statuses — don't break, just flag
            $mapped = @{ emoji = 'ℹ️'; label = $status }
        }

        # Build the payload Power Automate expects
        $payload = @{
            pipelineName    = $pipelineName
            pipelineRunName = $pipelineRunName
            status          = $mapped.label
            statusEmoji     = $mapped.emoji
            namespace       = $namespace
            timestamp       = (Get-Date -Format 'o')
            summary         = "$($mapped.emoji) Pipeline '$pipelineName' - $($mapped.label)"
        } | ConvertTo-Json -Depth 3 -Compress

        Write-Host "Built payload for $pipelineRunName [$status]"
        Write-Host "Payload: $payload"

        # Write outputs to Tekton Results.
        # Why -NoNewline? Tekton Results are read as raw strings —
        # a trailing newline would corrupt JSON parsing downstream.
        $payload | Out-File -FilePath $(results.notification-payload.path) -NoNewline
        $mapped.emoji | Out-File -FilePath $(results.status-emoji.path) -NoNewline

        Write-Host "Payload written to results successfully."
