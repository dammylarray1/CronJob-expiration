apiVersion: tekton.dev/v1beta1
kind: Task
metadata:
  name: teams-adaptive-card-notify
  labels:
    app.kubernetes.io/version: "0.2"
  annotations:
    tekton.dev/pipelines.minVersion: "0.12.1"
    tekton.dev/categories: Messaging
    tekton.dev/tags: messaging, microsoft-teams
    tekton.dev/displayName: "Send Adaptive Card to Microsoft Teams"
spec:
  description: >-
    Sends a richly formatted Adaptive Card notification to a Microsoft Teams
    channel via an Incoming Webhook. Supports pipeline run metadata including
    status, duration, task breakdown, and direct links to the Tekton dashboard.
  params:
    - name: webhook-url-secret
      type: string
      description: Name of the Kubernetes secret containing the Teams webhook URL
    - name: webhook-url-secret-key
      type: string
      description: Key within the secret that holds the webhook URL
      default: "url"
    - name: pipeline-run-name
      type: string
      description: Name of the PipelineRun (use $(context.pipelineRun.name))
    - name: pipeline-name
      type: string
      description: Name of the Pipeline (use $(context.pipeline.name))
    - name: namespace
      type: string
      description: Namespace where the PipelineRun executed
      default: "default"
    - name: pipeline-status
      type: string
      description: >-
        Aggregated status of all tasks. Use $(tasks.status) which resolves to
        Succeeded, Failed, or Completed (mixed results).
    - name: dashboard-url
      type: string
      description: Base URL of the Tekton Dashboard (e.g., https://tekton.example.com)
      default: ""
    - name: cluster-name
      type: string
      description: Friendly name for the cluster
      default: "kubernetes-cluster"
    - name: git-repo
      type: string
      description: Git repository URL (optional, for context)
      default: ""
    - name: git-branch
      type: string
      description: Git branch (optional, for context)
      default: ""
    - name: git-commit
      type: string
      description: Git commit SHA (optional, for context)
      default: ""
    - name: extra-message
      type: string
      description: Any additional message to include in the card
      default: ""
  steps:
    - name: send-adaptive-card
      image: mcr.microsoft.com/powershell:lts-ubi9  # PowerShell on UBI9 base
      env:
        - name: WEBHOOK_URL
          valueFrom:
            secretKeyRef:
              name: $(params.webhook-url-secret)
              key: $(params.webhook-url-secret-key)
      script: |
        #!/usr/bin/env pwsh
        $ErrorActionPreference = "Stop"

        # --- Determine status icon and color ---
        $Status = "$(params.pipeline-status)".Trim()

        switch ($Status) {
            { $_ -in @("Succeeded", "succeeded", "Completed", "completed", "True", "true") } {
                $StatusIcon  = "✅"
                $StatusColor = "Good"
                $StatusText  = "Succeeded"
            }
            { $_ -in @("Failed", "failed", "False", "false") } {
                $StatusIcon  = "❌"
                $StatusColor = "Attention"
                $StatusText  = "Failed"
            }
            default {
                $StatusIcon  = "⚠️"
                $StatusColor = "Warning"
                $StatusText  = "Completed (with issues)"
            }
        }

        # --- Build dashboard link ---
        $DashboardUrl = "$(params.dashboard-url)"
        $Namespace    = "$(params.namespace)"
        $PipelineRun  = "$(params.pipeline-run-name)"
        $RunLink      = ""

        if ($DashboardUrl) {
            $RunLink = "${DashboardUrl}/#/namespaces/${Namespace}/pipelineruns/${PipelineRun}"
        }

        # --- Build git info facts ---
        $GitRepo   = "$(params.git-repo)"
        $GitBranch = "$(params.git-branch)"
        $GitCommit = "$(params.git-commit)"

        $GitFacts = @()
        if ($GitRepo) {
            $GitFacts += @{ title = "Repository"; value = $GitRepo }
        }
        if ($GitBranch) {
            $GitFacts += @{ title = "Branch"; value = $GitBranch }
        }
        if ($GitCommit) {
            $ShortCommit = $GitCommit.Substring(0, [Math]::Min(8, $GitCommit.Length))
            $GitFacts += @{ title = "Commit"; value = $ShortCommit }
        }

        # --- Build core facts ---
        $Facts = @(
            @{ title = "PipelineRun"; value = $PipelineRun }
            @{ title = "Namespace";   value = $Namespace }
            @{ title = "Cluster";     value = "$(params.cluster-name)" }
            @{ title = "Status";      value = $StatusText }
        )
        $Facts += $GitFacts

        # --- Build card body ---
        $Body = @(
            @{
                type    = "ColumnSet"
                columns = @(
                    @{
                        type                     = "Column"
                        width                    = "auto"
                        verticalContentAlignment = "Center"
                        items                    = @(
                            @{ type = "TextBlock"; text = $StatusIcon; size = "Large" }
                        )
                    }
                    @{
                        type  = "Column"
                        width = "stretch"
                        items = @(
                            @{
                                type   = "TextBlock"
                                text   = "Tekton Pipeline: ${StatusText}"
                                weight = "Bolder"
                                size   = "Medium"
                                color  = $StatusColor
                                wrap   = $true
                            }
                            @{
                                type     = "TextBlock"
                                text     = "$(params.pipeline-name)"
                                spacing  = "None"
                                isSubtle = $true
                                wrap     = $true
                            }
                        )
                    }
                )
            }
            @{
                type  = "FactSet"
                facts = $Facts
            }
        )

        # --- Add extra message block if provided ---
        $ExtraMsg = "$(params.extra-message)"
        if ($ExtraMsg) {
            $Body += @{
                type    = "TextBlock"
                text    = $ExtraMsg
                wrap    = $true
                spacing = "Medium"
            }
        }

        # --- Add dashboard button if URL provided ---
        if ($RunLink) {
            $Body += @{
                type    = "ActionSet"
                actions = @(
                    @{
                        type  = "Action.OpenUrl"
                        title = "View PipelineRun in Dashboard"
                        url   = $RunLink
                        style = "positive"
                    }
                )
            }
        }

        # --- Compose the Adaptive Card payload ---
        $Payload = @{
            type        = "message"
            attachments = @(
                @{
                    contentType = "application/vnd.microsoft.card.adaptive"
                    contentUrl  = $null
                    content     = @{
                        '$schema' = "http://adaptivecards.io/schemas/adaptive-card.json"
                        type      = "AdaptiveCard"
                        version   = "1.4"
                        body      = $Body
                    }
                }
            )
        } | ConvertTo-Json -Depth 20 -Compress

        # --- Send to Teams ---
        Write-Host "Sending notification to Microsoft Teams..."

        try {
            $Response = Invoke-RestMethod `
                -Uri $env:WEBHOOK_URL `
                -Method Post `
                -ContentType "application/json" `
                -Body $Payload `
                -StatusCodeVariable "StatusCode"

            Write-Host "Response code: $StatusCode"
            Write-Host "Teams notification sent successfully."
        }
        catch {
            $ErrStatus = $_.Exception.Response.StatusCode.value__
            Write-Host "ERROR: Failed to send Teams notification (HTTP ${ErrStatus})"
            Write-Host $_.Exception.Message
            exit 1
        }
