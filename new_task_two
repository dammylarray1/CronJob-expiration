# task-teams-notify.yaml
apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: teams-notify
  namespace: tekton-notifications
spec:
  description: |
    Posts a rich Adaptive Card to Microsoft Teams via a Workflow webhook.
    Uses PowerShell so we get native JSON handling (ConvertTo-Json -Depth)
    and robust HTTP error handling via Invoke-RestMethod.
  params:
    - name: pipeline-run-name
      type: string
      description: Name of the completed PipelineRun
    - name: pipeline-run-status
      type: string
      description: "Succeeded or Failed"
    - name: pipeline-run-namespace
      type: string
      description: Namespace the PipelineRun ran in
    - name: pipeline-name
      type: string
      description: Name of the Pipeline definition
    - name: start-time
      type: string
      default: "unknown"
      description: PipelineRun start timestamp
    - name: completion-time
      type: string
      default: "unknown"
      description: PipelineRun completion timestamp
  steps:
    - name: send-teams-notification
      # Why ubi9? Red Hat's Universal Base Image is approved for OpenShift
      # clusters and most enterprise registries. We install pwsh on top.
      image: mcr.microsoft.com/powershell:lts-ubi9
      env:
        - name: TEAMS_WEBHOOK_URL
          valueFrom:
            secretKeyRef:
              name: teams-webhook-secret
              key: webhook-url
      script: |
        #!/usr/bin/env pwsh
        <#
        .SYNOPSIS
            Sends a PipelineRun status notification to MS Teams as an Adaptive Card.
        .DESCRIPTION
            Why PowerShell?
            1. ConvertTo-Json -Depth handles nested Adaptive Card JSON reliably
               (no manual escaping like in bash/curl).
            2. Invoke-RestMethod gives structured error objects on failure,
               making debugging easier than curl exit codes.
            3. Enterprise teams often standardise on pwsh for cross-platform scripting.
        #>

        # --- Read parameters from Tekton ---
        $pipelineRunName   = "$(params.pipeline-run-name)"
        $status            = "$(params.pipeline-run-status)"
        $namespace         = "$(params.pipeline-run-namespace)"
        $pipelineName      = "$(params.pipeline-name)"
        $startTime         = "$(params.start-time)"
        $completionTime    = "$(params.completion-time)"
        $webhookUrl        = $env:TEAMS_WEBHOOK_URL

        # --- Determine visual indicators based on status ---
        # Why? Adaptive Cards support colour-coded containers. Green/red gives
        # instant visual feedback in a busy Teams channel.
        if ($status -eq "Succeeded") {
            $statusEmoji  = "✅"
            $accentColor  = "good"      # green in Adaptive Cards
            $statusText   = "Succeeded"
        } else {
            $statusEmoji  = "❌"
            $accentColor  = "attention"  # red in Adaptive Cards
            $statusText   = "Failed"
        }

        # --- Build the Adaptive Card payload ---
        # Why Adaptive Cards? MS Teams Workflow webhooks expect the Adaptive Card
        # schema (not the legacy MessageCard). This is the only format that
        # renders correctly with the new Workflows connector.
        $adaptiveCard = @{
            type        = "message"
            attachments = @(
                @{
                    contentType = "application/vnd.microsoft.card.adaptive"
                    content     = @{
                        '$schema' = "http://adaptivecards.io/schemas/adaptive-card.json"
                        type      = "AdaptiveCard"
                        version   = "1.4"
                        body      = @(
                            # Header container with accent colour
                            @{
                                type  = "Container"
                                style = $accentColor
                                items = @(
                                    @{
                                        type   = "TextBlock"
                                        text   = "$statusEmoji Pipeline Run $statusText"
                                        weight = "Bolder"
                                        size   = "Large"
                                        color  = if ($status -eq "Succeeded") { "Good" } else { "Attention" }
                                    }
                                )
                                bleed = $true
                            },
                            # Fact set — compact key-value display
                            # Why FactSet? It's the Adaptive Card way to show
                            # structured metadata without building a manual table.
                            @{
                                type  = "FactSet"
                                facts = @(
                                    @{ title = "Pipeline";        value = $pipelineName }
                                    @{ title = "PipelineRun";     value = $pipelineRunName }
                                    @{ title = "Namespace";       value = $namespace }
                                    @{ title = "Status";          value = "$statusEmoji $statusText" }
                                    @{ title = "Started";         value = $startTime }
                                    @{ title = "Completed";       value = $completionTime }
                                )
                            },
                            # Timestamp footer
                            @{
                                type      = "TextBlock"
                                text      = "Notification sent at $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss UTC' -AsUTC)"
                                isSubtle  = $true
                                size      = "Small"
                                wrap      = $true
                            }
                        )
                        # Optional: Add an "Open in Dashboard" action if you have
                        # a Tekton Dashboard or OpenShift Console URL.
                        # actions = @(
                        #     @{
                        #         type  = "Action.OpenUrl"
                        #         title = "View in Dashboard"
                        #         url   = "https://tekton-dashboard.example.com/#/namespaces/$namespace/pipelineruns/$pipelineRunName"
                        #     }
                        # )
                    }
                }
            )
        }

        # --- Convert to JSON ---
        # Why -Depth 20? The Adaptive Card is deeply nested. PowerShell's default
        # depth of 2 would silently truncate the body array, producing invalid JSON
        # that Teams rejects with a cryptic 400 error.
        $jsonPayload = $adaptiveCard | ConvertTo-Json -Depth 20 -Compress

        # --- Send to Teams ---
        Write-Host "========================================"
        Write-Host "Sending notification for: $pipelineRunName"
        Write-Host "Status: $statusText"
        Write-Host "========================================"

        try {
            $response = Invoke-RestMethod `
                -Uri $webhookUrl `
                -Method Post `
                -ContentType "application/json" `
                -Body $jsonPayload `
                -ErrorAction Stop

            Write-Host "✅ Notification sent successfully."
            Write-Host "Response: $response"
        }
        catch {
            # Why detailed error logging? Teams webhook errors are notoriously
            # vague. Dumping the full exception helps diagnose schema issues.
            Write-Error "❌ Failed to send Teams notification."
            Write-Error "Status Code: $($_.Exception.Response.StatusCode.value__)"
            Write-Error "Error: $($_.Exception.Message)"

            # Print the payload so you can paste it into https://adaptivecards.io/designer/
            # to debug the card structure visually.
            Write-Host "--- Payload sent ---"
            Write-Host $jsonPayload
            exit 1
        }
